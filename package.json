{
  "name": "jungle-nft-marketplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:tablet": "playwright test --project=tablet-chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:e2e:visual:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "lighthouse:desktop": "lhci autorun --config=./lighthouse/lighthouserc.desktop.cjs",
    "lighthouse:mobile": "lhci autorun --config=./lighthouse/lighthouserc.mobile.cjs",
    "lighthouse:summary": "node ./scripts/summarize-lighthouse.mjs",
    "lighthouse": "npm run build && npm run lighthouse:desktop && npm run lighthouse:mobile && npm run lighthouse:summary"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/space-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.5",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@tanstack/router-plugin": "^1.168.46",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "msw": "^2.15.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
